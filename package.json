{
  "name": "@drey/core",
  "description": "Drey — platform-free Bitcoin L1 and Ordinals wallet core (domain, messaging, scan, gateway client)",
  "private": true,
  "version": "0.10.1",
  "license": "AGPL-3.0-only",
  "author": "Squirrel Systems LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreywallet/core.git"
  },
  "type": "module",
  "exports": {
    "./domain/*": "./src/domain/*.ts",
    "./messaging/*": "./src/messaging/*.ts",
    "./scan/*": "./src/scan/*.ts",
    "./gateway-client": "./src/gateway-client.ts",
    "./provider/*": "./src/provider/*.ts",
    "./testing/*": "./src/testing/*.ts",
    "./vectors/crypto-conformance.json": "./vectors/crypto-conformance.json",
    "./vectors/vault-contracts-v1.json": "./vectors/vault-contracts-v1.json",
    "./vectors/vault-role-v1.json": "./vectors/vault-role-v1.json",
    "./vectors/vault-descriptors-v1.json": "./vectors/vault-descriptors-v1.json",
    "./vectors/vault-psbt-v1.json": "./vectors/vault-psbt-v1.json",
    "./vectors/vault-asset-policy-v1.json": "./vectors/vault-asset-policy-v1.json",
    "./vectors/vault-coordinator-v1.json": "./vectors/vault-coordinator-v1.json",
    "./vectors/vault-recovery-kit-v1.json": "./vectors/vault-recovery-kit-v1.json",
    "./vectors/vault-recovery-plan-v1.json": "./vectors/vault-recovery-plan-v1.json",
    "./vectors/recovery-c-ceremony-v1.json": "./vectors/recovery-c-ceremony-v1.json",
    "./vectors/bc-ur-v2.json": "./vectors/bc-ur-v2.json",
    "./vectors/passkey-envelope-v1.json": "./vectors/passkey-envelope-v1.json",
    "./vectors/native-send-v1.json": "./vectors/native-send-v1.json",
    "./vectors/public-account-v1.json": "./vectors/public-account-v1.json",
    "./fixtures/*": "./tests/fixtures/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:marketplace-contracts": "vitest run tests/marketplaces",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fixtures:sync": "node scripts/sync-gateway-fixtures.mjs",
    "vectors:generate": "node scripts/generate-conformance-vectors.mjs && vite build --config scripts/vault-vector-vite.config.ts && node node_modules/.cache/drey-vault-vector-generator/generate.mjs && pnpm recovery:vectors",
    "recovery:vectors": "vite build --config recovery/vectors.config.ts && node node_modules/.cache/drey-recovery-vector-generator/generate.mjs",
    "recovery:build": "vite build --config recovery/vite.config.ts",
    "recovery:digest": "node recovery/digest.mjs",
    "recovery:verify": "node recovery/check-reproducible.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@scure/base": "~1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@scure/btc-signer": "^1.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^26.1.2",
    "eslint": "^9.30.0",
    "fast-check": "^4.9.0",
    "libsodium-wrappers-sumo": "^0.7.16",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "7.3.6",
    "vitest": "^3.2.0"
  }
}
